g"],"tags":[],"content":""},"datos/perros/comida/calabaza-(perros)":{"slug":"datos/perros/comida/calabaza-(perros)","filePath":"Datos/Perros/Comida/Calabaza (Perros).md","title":"Calabaza (Perros)","links":["datos/galery/alimentos/calabazas.png"],"tags":[],"content":""},"datos/perros/comida/carne-de-res-magra-(perros)":{"slug":"datos/perros/comida/carne-de-res-magra-(perros)","filePath":"Datos/Perros/Comida/Carne de res magra (Perros).md","title":"Carne de res magra (Perros)","links":["datos/galery/alimentos/carne_res.jpg"],"tags":[],"content":""},"datos/perros/comida/cebolla-(perros)":{"slug":"datos/perros/comida/cebolla-(perros)","filePath":"Datos/Perros/Comida/Cebolla (Perros).md","title":"Cebolla (Perros)","links":["datos/galery/alimentos/cebolla.jpg"],"tags":[],"content":""},"datos/perros/comida/chocolate-(perros)":{"slug":"datos/perros/comida/chocolate-(perros)","filePath":"Datos/Perros/Comida/Chocolate (Perros).md","title":"Chocolate (Perros)","links":["datos/galery/alimentos/chocolate.jpg"],"tags":[],"content":""},"datos/perros/comida/durazno-sin-semilla-(perros)":{"slug":"datos/perros/comida/durazno-sin-semilla-(perros)","filePath":"Datos/Perros/Comida/Durazno sin semilla (Perros).md","title":"Durazno sin semilla (Perros)","links":["datos/galery/alimentos/durazno.jpg"],"tags":[],"content":""},"datos/perros/comida/huesos-cocidos-(perros)":{"slug":"datos/perros/comida/huesos-cocidos-(perros)","filePath":"Datos/Perros/Comida/Huesos cocidos (Perros).md","title":"Huesos cocidos (Perros)","links":["datos/galery/alimentos/huesos.png"],"tags":[],"content":""},"datos/perros/comida/huevo-cocido-(perros)":{"slug":"datos/perros/comida/huevo-cocido-(perros)","filePath":"Datos/Perros/Comida/Huevo cocido (Perros).md","title":"Huevo cocido (Perros)","links":["datos/galery/alimentos/huevos.png"],"tags":[],"content":"Recomendaciones importantes:\nMejor cocido (hervido o revuelto sin sal, aceite ni condimentos) que crudo. El huevo crudo tiene riesgo de salmonela y contiene avidina, una proteína que puede interferir con la absorción de biotina si se da de forma regular.\nIntroduce el huevo poco a poco la primera vez, para descartar alergias o problemas digestivos.\nLa cáscara (bien triturada, casi en polvo) puede darse como aporte extra de calcio, si quieres aprovecharla.\nSi tu perro tiene sobrepeso, pancreatitis, problemas renales o colesterol alto, es mejor consultar antes con el veterinario, ya que el huevo tiene bastante grasa y colesterol.\nEn general, el huevo no debería superar el 10% de las calorías diarias totales de la dieta. Si tienes dudas sobre la cantidad exacta para tu perro en particular (por su peso, actividad o alguna condición de salud), lo ideal es consultarlo con su veterinario para ajustarlo a su caso."},"datos/perros/comida/leche-(en-exceso)-(perros)":{"slug":"datos/perros/comida/leche-(en-exceso)-(perros)","filePath":"Datos/Perros/Comida/Leche (en exceso) (Perros).md","title":"Leche (en exceso) (Perros)","links":["datos/galery/alimentos/leche.png"],"tags":[],"content":""},"datos/perros/comida/mandarina-sin-semillas-(perros)":{"slug":"datos/perros/comida/mandarina-sin-semillas-(perros)","filePath":"Datos/Perros/Comida/Mandarina sin semillas (Perros).md","title":"Mandarina sin semillas (Perros)","links":["datos/galery/alimentos/mandarina.jpeg"],"tags":[],"content":""},"datos/perros/comida/manzana-(sin-semillas)-(perros)":{"slug":"datos/perros/comida/manzana-(sin-semillas)-(perros)","filePath":"Datos/Perros/Comida/Manzana (sin semillas) (Perros).md","title":"Manzana (sin semillas) (Perros)","links":["datos/galery/alimentos/manzanas.jpg"],"tags":[],"content":""},"datos/perros/comida/pescado---salmón-(perros)":{"slug":"datos/perros/comida/pescado---salmón-(perros)","filePath":"Datos/Perros/Comida/Pescado - salmón (Perros).md","title":"Pescado - salmón (Perros)","links":["datos/galery/alimentos/pescado.jpg"],"tags":[],"content":""},"datos/perros/comida/plátano-(perros)":{"slug":"datos/perros/comida/plátano-(perros)","f